# Neon serverless Postgres connection string (free plan).
# Get it from https://console.neon.tech -> your project -> Connection string (pooled).
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon Managed Better Auth. Base URL comes from the Neon console (Auth -> Configuration).
# Generate the cookie secret with: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Web push (VAPID keypair). Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Integration tests (src/db/*.integration.test.ts) run against a throwaway Neon branch.
# They skip entirely when this is unset, so `pnpm verify` stays green without it.
# Create one with:  neon branches create --project-id <id> --name test-integration
# It MUST NOT be the same database as DATABASE_URL -- the suite truncates every table.
TEST_DATABASE_URL=
# The branch only needs refreshing when a migration lands:
#   neon branches reset <branch> --parent
